#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() 
{
    int n, links;
    cout << "Enter number of departments: ";
    cin >> n;

    vector<string> dept(n);
    vector<vector<int> > adj(n, vector<int>(n, 0));

    cout << "Enter department names:\n";
    for (int i = 0; i < n; i++) 
    {
        cin >> dept[i];
    }

    cout << "Enter number of communication links: ";
    cin >> links;

    cout << "Enter linked department indices (1-based):\n";
    for (int i = 0; i < links; i++)
     {
        int u, v;
        cin >> u >> v;

        if (u >= 1 && u <= n && v >= 1 && v <= n && u != v) 
       {
            adj[u - 1][v - 1] = 1;
            adj[v - 1][u - 1] = 1;
        } 
        else
         {
            cout << "Invalid department indices. Try again.\n";
            i--;
        }
    }

    cout << "\nAdjacency Matrix:\n   ";
    for (int i = 0; i < n; i++)
        cout << dept[i] << " ";
    cout << "\n";

    for (int i = 0; i < n; i++) 
      {
        cout << dept[i] << " ";
        for (int j = 0; j < n; j++)
            cout << adj[i][j] << "  ";
        cout << "\n";
      }

    int a, b;
    cout << "\nEnter two department indices to check: ";
    cin >> a >> b;

    if (a >= 1 && a <= n && b >= 1 && b <= n)
     {
        if (adj[a - 1][b - 1] == 1)
            cout << "Communication link exists between "
                 << dept[a - 1] << " and " << dept[b - 1] << ".\n";
        else
            cout << "No communication link exists between "
                 << dept[a - 1] << " and " << dept[b - 1] << ".\n";
    } 
    else
    {
        cout << "Invalid department indices.\n";
    }

    return 0;
}